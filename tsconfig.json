{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "react"],
    "lib": ["ES2022", "DOM"],
    "noEmit": true
  },
  "include": ["src", "tests", "raycast-env.d.ts"]
}
